# Keep text resources consistent across development platforms.
* text=auto
*.gd text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.uid text eol=lf
*.import text eol=lf

# Binary assets must not be line-ending converted or text-merged.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
